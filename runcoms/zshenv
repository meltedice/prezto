# Move environment variables to zshrc, if prior to /usr/bin, etc.


# Ensure that a non-login, non-interactive shell has a defined environment.
if [[ ( "$SHLVL" -eq 1 && ! -o LOGIN ) && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi
# . "$HOME/.cargo/env"

# Volta
if [ -d "$HOME/.volta" ]; then
  export VOLTA_HOME="$HOME/.volta"
  export PATH="$VOLTA_HOME/bin:$PATH"
  export VOLTA_FEATURE_PNPM=1
fi

# pnpm
export PNPM_HOME="${HOME}/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# Go
# go 本体は Homebrew(/opt/homebrew/bin、zprofile で PATH 済み)で使える。
# `go install` で入れたツールは ~/go/bin (既定 GOPATH/bin) に入るのでここを通す。
# (go env GOPATH を毎回呼ぶと遅いので直書き。存在しなくても無害)
export PATH="$HOME/go/bin:$PATH"

# Forbid npm
npm() {
  echo "❌ npm の使用は禁止しています。pnpm を使ってください。"
  return 1
}
